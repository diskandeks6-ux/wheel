<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Колесо удачи</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
  :root { color-scheme: dark; }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; background: #14121f; color: #fff; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  body { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px; padding: 16px; }
  h1 { margin: 0; font-size: 22px; letter-spacing: .5px; }
  .stage { position: relative; width: min(88vw, 380px); aspect-ratio: 1; }
  canvas { width: 100%; height: 100%; display: block; transition: transform 5.2s cubic-bezier(.12,.67,.1,1); }
  .pointer { position: absolute; top: -10px; left: 50%; width: 0; height: 0; transform: translateX(-50%);
    border-left: 14px solid transparent; border-right: 14px solid transparent; border-top: 28px solid #ffd54a;
    filter: drop-shadow(0 2px 3px rgba(0,0,0,.6)); z-index: 2; }
  .hub { position: absolute; inset: 0; margin: auto; width: 16%; aspect-ratio: 1; border-radius: 50%;
    background: #ffd54a; box-shadow: 0 0 0 5px #14121f, 0 0 14px rgba(255,213,74,.6); z-index: 1; }
  button { font: inherit; font-weight: 700; font-size: 18px; padding: 14px 34px; border: 0; border-radius: 14px;
    background: #ffd54a; color: #14121f; cursor: pointer; }
  button:disabled { opacity: .5; }
  #result { min-height: 56px; text-align: center; font-size: 20px; font-weight: 700; }
  #result small { display: block; font-weight: 400; font-size: 14px; opacity: .75; margin-top: 4px; }
</style>
</head>
<body>
  <h1>🎡 Колесо удачи</h1>
  <div class="stage">
    <div class="pointer"></div>
    <canvas id="wheel" width="760" height="760"></canvas>
    <div class="hub"></div>
  </div>
  <button id="spin">Крутить</button>
  <div id="result"></div>
<script>
(function () {
  var tg = window.Telegram && window.Telegram.WebApp;
  if (tg) { try { tg.ready(); tg.expand(); } catch (e) {} }

  var q = new URLSearchParams(location.search);
  var labels = (q.get("l") || "Пусто|×2|×5|Джекпот").split("|").filter(Boolean);
  var win = parseInt(q.get("w"), 10);
  var hasResult = !isNaN(win) && win >= 0 && win < labels.length;
  var n = labels.length;
  var seg = 360 / n;
  var colors = ["#e63946", "#2a9d8f", "#f4a261", "#6a4c93", "#1d8cf8", "#e9c46a", "#ef476f", "#06d6a0"];

  var canvas = document.getElementById("wheel");
  var ctx = canvas.getContext("2d");
  var R = canvas.width / 2;

  for (var i = 0; i < n; i++) {
    var a0 = (-90 + i * seg) * Math.PI / 180;
    var a1 = (-90 + (i + 1) * seg) * Math.PI / 180;
    ctx.beginPath(); ctx.moveTo(R, R); ctx.arc(R, R, R - 6, a0, a1); ctx.closePath();
    ctx.fillStyle = colors[i % colors.length]; ctx.fill();
    ctx.lineWidth = 3; ctx.strokeStyle = "#14121f"; ctx.stroke();
    ctx.save();
    ctx.translate(R, R);
    ctx.rotate((a0 + a1) / 2);
    ctx.textAlign = "right"; ctx.fillStyle = "#fff";
    var fs = n > 8 ? 34 : 44;
    ctx.font = "700 " + fs + "px system-ui, sans-serif";
    var text = labels[i].length > 12 ? labels[i].slice(0, 11) + "…" : labels[i];
    ctx.fillText(text, R - 44, fs / 3);
    ctx.restore();
  }
  ctx.beginPath(); ctx.arc(R, R, R - 3, 0, 2 * Math.PI); ctx.lineWidth = 6; ctx.strokeStyle = "#ffd54a"; ctx.stroke();

  var btn = document.getElementById("spin");
  var res = document.getElementById("result");

  if (!hasResult) {
    btn.disabled = true;
    res.innerHTML = "Открой колесо из бота: «🏦 Банк» → «🎡 Колесо удачи»";
  }

  btn.addEventListener("click", function () {
    if (!hasResult || btn.disabled) return;
    btn.disabled = true;
    var jitter = (Math.random() - .5) * seg * .7;
    var finalDeg = 360 * 6 - (win + .5) * seg + jitter;
    canvas.style.transform = "rotate(" + finalDeg + "deg)";
    if (tg && tg.HapticFeedback) { try { tg.HapticFeedback.impactOccurred("medium"); } catch (e) {} }
    setTimeout(function () {
      var prize = labels[win];
      res.innerHTML = "Выпало: " + prize.replace(/</g, "&lt;") + "<small>Результат уже применён в боте</small>";
      if (tg && tg.HapticFeedback) { try { tg.HapticFeedback.notificationOccurred("success"); } catch (e) {} }
    }, 5400);
  });
})();
</script>
</body>
</html>
